{
  "api": "1.5",
  "schemaVersion": 1,
  "id": "cn.cyrene2008.sound-effects",
  "name": "来点音效",
  "version": "1.3.0",
  "author": "Cyrene2008",
  "description": "为随机点名、翻牌点名和抽奖添加可选音效。",
  "engine": {
    "min": "1.5.0",
    "max": "1.5.0"
  },
  "entry": {
    "runtime": "cnrp-runner",
    "script": "src/worker.js",
    "args": []
  },
  "icon": "assets/icon.svg",
  "readme": "README.md",
  "platforms": ["web", "tauri"],
  "permissions": [
    { "id": "storage:read", "required": true, "platforms": ["web", "tauri"] },
    { "id": "storage:write", "required": true, "platforms": ["web", "tauri"] },
    { "id": "events:draw", "required": true, "platforms": ["web", "tauri"] },
    { "id": "events:lifecycle", "required": false, "platforms": ["web", "tauri"] },
    { "id": "notifications:show", "required": false, "platforms": ["web", "tauri"] },
    { "id": "audio:select", "required": false, "platforms": ["web", "tauri"] },
    { "id": "audio:play", "required": false, "platforms": ["web", "tauri"] }
  ],
  "pages": [
    {
      "id": "sound-settings",
      "title": "音效",
      "location": "main",
      "description": "为随机点名、翻牌点名和抽奖分别配置本地音频。",
      "native": {
        "type": "settings",
        "settingsKey": "settings",
        "controls": [
          { "id": "enabled", "type": "toggle", "path": "enabled", "label": "启用音效", "description": "关闭后保留所有音频配置，但不再播放。", "default": true },
          { "id": "volume", "type": "range", "path": "volume", "label": "音量", "description": "统一调整所有插件音效的播放音量。", "min": 0, "max": 1, "step": 0.01, "default": 0.7 },
          { "id": "playback-mode", "type": "select", "path": "playbackMode", "label": "播放逻辑", "description": "多人抽取时可以只播放一次，避免连续播放。", "default": "once", "options": [{ "value": "once", "label": "每次操作播放一次" }, { "value": "each", "label": "每个结果都播放" }] },
          { "id": "roller-audio", "type": "audio", "path": "roller", "label": "随机点名", "description": "随机点名完成时播放。", "accept": "audio/*,.mp3,.m4a,.wav,.flac,.ogg", "default": null },
          { "id": "card-audio", "type": "audio", "path": "card", "label": "翻牌点名", "description": "翻牌点名完成时播放。", "accept": "audio/*,.mp3,.m4a,.wav,.flac,.ogg", "default": null },
          { "id": "lottery-audio", "type": "audio", "path": "lottery", "label": "抽奖", "description": "抽奖或奖品分配完成时播放。", "accept": "audio/*,.mp3,.m4a,.wav,.flac,.ogg", "default": null }
        ]
      }
    }
  ]
}
